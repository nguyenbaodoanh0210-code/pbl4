# Keep real credentials in your local environment; do not commit them.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/smart_greenhouse_db
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
DEVICE_INGEST_TOKEN=replace-with-a-different-long-random-device-token
DEMO_MODE=false
DEMO_USER_EMAIL=demo@smartgreenhouse.local

MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC=smart_greenhouse/24T_Nhat1/sensors
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# Optional demo thresholds only. Set crop/stage-specific references after validation.
# REF_N_MIN=
# REF_P_MIN=
# REF_K_MIN=
